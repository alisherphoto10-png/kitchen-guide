# Взять на https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Номер телефона Алишера в международном формате, для первого логина
TG_PHONE=+998

# Имя session-файла (создастся сам при первом запуске)
TG_SESSION_NAME=oko_supply_bot

# Порт веб-сервера формы заказа (webapp_server.py)
WEBAPP_PORT=8081

# Отдельная сессия для webapp_server.py — не должна совпадать с TG_SESSION_NAME:
# один и тот же .session, открытый двумя процессами одновременно (autoresponder.py
# и webapp_server.py), приводит к sqlite "database is locked" и падению апдейт-лупа
WEBAPP_SESSION_NAME=oko_supply_bot_webapp
