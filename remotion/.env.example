# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real API keys.

# Which provider generateVoice() uses by default: "openai" or "elevenlabs".
TTS_PROVIDER=openai

# --- OpenAI TTS (https://platform.openai.com/docs/guides/text-to-speech) ---
OPENAI_API_KEY=
# Model: gpt-4o-mini-tts | tts-1 | tts-1-hd
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voice: alloy | ash | coral | echo | fable | onyx | nova | sage | shimmer
OPENAI_TTS_VOICE=onyx

# --- ElevenLabs (https://elevenlabs.io/docs/api-reference/text-to-speech) ---
ELEVENLABS_API_KEY=
# Find voice IDs at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
