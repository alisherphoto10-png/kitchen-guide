node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Rendered videos stay local, only keep the folder structure.
renders/*
!renders/.gitkeep

# Generated/imported audio stays local too — only keep the folder structure.
# Drop your own music/sfx library files locally; generated voice-overs and
# mixdowns are regenerated by the audio pipeline, not committed.
public/voice/*
!public/voice/.gitkeep
public/music/*
!public/music/.gitkeep
public/sfx/*
!public/sfx/.gitkeep
public/audio/*
!public/audio/.gitkeep
