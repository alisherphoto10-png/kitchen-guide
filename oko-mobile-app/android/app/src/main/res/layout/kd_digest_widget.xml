<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Моя сводка» (2026-10-16): слева дата крупно (вместо календаря), справа
     счётчики; ниже до трёх строк «Ждёт вашего решения». Только классы, разрешённые
     RemoteViews (LinearLayout/FrameLayout/TextView). Заполняет DigestWidget.render. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kd_widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:includeFontPadding="false" android:text="16" android:textSize="30sp" android:textStyle="bold"
            android:textColor="#FFE8ECF4" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="9dp" android:orientation="vertical">
            <TextView android:id="@+id/w_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="пятница" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFE8ECF4" />
            <TextView android:id="@+id/w_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="октября" android:textSize="11.5sp" android:textColor="#FF98A2B6" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/w_decide" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="решить 0" android:textSize="13sp" android:textStyle="bold" android:textColor="#FF98A2B6" />
            <TextView android:id="@+id/w_counts" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="сегодня 0 · завтра 0" android:textSize="11sp" android:textColor="#FF98A2B6" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="8dp" android:background="#FF1E2736" />

    <LinearLayout
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView android:id="@+id/w_dot1" android:layout_width="12dp" android:layout_height="wrap_content"
            android:text="●" android:textSize="8sp" android:textColor="#FFE2A03F" />
        <TextView android:id="@+id/w_icon1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="6dp" android:textSize="14sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/w_title1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textStyle="bold"
                android:textColor="#FFE8ECF4" />
            <TextView android:id="@+id/w_text1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="11.5sp" android:textColor="#FF98A2B6" />
        </LinearLayout>
        <TextView android:id="@+id/w_time1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="#FF6B7589" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView android:id="@+id/w_dot2" android:layout_width="12dp" android:layout_height="wrap_content"
            android:text="●" android:textSize="8sp" android:textColor="#FFE2A03F" />
        <TextView android:id="@+id/w_icon2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="6dp" android:textSize="14sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/w_title2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textStyle="bold"
                android:textColor="#FFE8ECF4" />
            <TextView android:id="@+id/w_text2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="11.5sp" android:textColor="#FF98A2B6" />
        </LinearLayout>
        <TextView android:id="@+id/w_time2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="#FF6B7589" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView android:id="@+id/w_dot3" android:layout_width="12dp" android:layout_height="wrap_content"
            android:text="●" android:textSize="8sp" android:textColor="#FFE2A03F" />
        <TextView android:id="@+id/w_icon3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="6dp" android:textSize="14sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/w_title3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textStyle="bold"
                android:textColor="#FFE8ECF4" />
            <TextView android:id="@+id/w_text3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textSize="11.5sp" android:textColor="#FF98A2B6" />
        </LinearLayout>
        <TextView android:id="@+id/w_time3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="#FF6B7589" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Ничего не ждёт — можно выдохнуть"
        android:textSize="13sp"
        android:textColor="#FF98A2B6" />

    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="10sp"
        android:textColor="#FF6B7589" />
</LinearLayout>
