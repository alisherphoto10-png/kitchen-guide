<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка-фраза в окне быстрого ответа (QuickReplyActivity); нажатие — чуть светлее -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF22304A" />
            <stroke android:width="1dp" android:color="#FF6F9BFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF121925" />
            <stroke android:width="1dp" android:color="#FF1E2736" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF161E2C" />
            <stroke android:width="1dp" android:color="#FF2A3446" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
